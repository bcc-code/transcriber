# Copy to .env and edit. `docker compose` reads .env automatically.
# Every value here is optional — the defaults in docker-compose.yml match these.
#
# Requires an NVIDIA GPU + driver >= 560.28.03. There is no CPU-only mode for
# this image; see DEPLOY.md.

# ---- Image ----
# Pull a CI-built image instead of building on every host.
# Pin a tag (e.g. :sha-abc1234) in production so you can roll back.
IMAGE=ghcr.io/bcc-code/transcriber:latest

# Prebuilt whisper.cpp + CUDA base, used only by `docker compose build`. Bump to
# change the whisper.cpp or CUDA version; build it with
# .github/workflows/whisper-base.yml. The tag encodes both versions.
BASE_IMAGE=ghcr.io/bcc-code/whisper-cuda:v1.8.6-cuda12.6.3

# Forced-aligner service image (aligner/). Pin alongside IMAGE.
ALIGNER_IMAGE=ghcr.io/bcc-code/transcriber-aligner:latest

# ---- Storage ----
# Must already exist on the host, and must be the same path the caller puts in
# the `path` / `output_path` fields — they are resolved inside the container.
STORAGE_PATH=/mnt/storage
# Additional read-only mount for source audio (e.g. the Isilon share). Same
# rules: must exist on the host and match the paths the caller sends.
SOURCE_PATH=/mnt/isilon

# ---- Network ----
# The API is unauthenticated. Set this to an internal interface, or firewall
# the port, so only the workflow engine can reach it.
BIND_ADDR=0.0.0.0
PORT=8888

# ---- Runtime ----
# Concurrent transcription jobs. Each one runs its own whisper-cli process
# holding a ~3 GB FP16 large-v3 model on the GPU; 2 fits comfortably in the
# 3090's 24 GB, but raising this risks CUDA OOM (which surfaces as a failed job).
# Each job also uses scratch disk for chunk extraction (~115 MB per hour of
# audio), under the OS temp dir unless -scratch-dir is set.
WORKERS=2
# Concurrent jobs on cloud models (ElevenLabs, OpenRouter). They have their own
# queue and pool, independent of WORKERS, since they only wait on a remote API.
REMOTE_WORKERS=10
CALLBACK_WORKERS=2
DEFAULT_MODEL=whisper-cpp-large-v3
# ISO 639-1 code to skip whisper's language auto-detection (faster and more
# reliable for a mono-lingual corpus). Empty = auto-detect. Requests can
# override per job.
DEFAULT_LANGUAGE=no
JOB_TIMEOUT=30m
# How long finished jobs stay queryable after they end. Job state lives in
# SQLite on the `state` volume, so it survives redeploys; after this window a
# GET for the job is a 404.
RETENTION=168h
LOG_FORMAT=json

# ---- ElevenLabs (optional) ----
# Enables the cloud Scribe backends. Clients choose one per job with
# "model": "elevenlabs-scribe-v3", "elevenlabs-scribe-v2" or "elevenlabs-scribe-v1" (also accepted:
# "elevenlabs/scribe_v3", "elevenlabs/scribe_v2", "elevenlabs/scribe_v1"). "elevenlabs-scribe" resolves
# to ELEVENLABS_DEFAULT_MODEL. NOTE: audio for those jobs is uploaded to
# ElevenLabs, a third party. Unset = backends not registered.
# ELEVENLABS_API_KEY=
# ELEVENLABS_DEFAULT_MODEL=elevenlabs-scribe-v2

# ---- OpenRouter (optional) ----
# Enables cloud speech-to-text via OpenRouter. Norwegian-capable models are
# registered as "openrouter/<slug>" (e.g. "openrouter/openai/whisper-large-v3"),
# checked against OpenRouter's model list at boot. OPENROUTER_MODELS replaces
# the built-in list; "openrouter" resolves to OPENROUTER_DEFAULT_MODEL. NOTE: audio for those jobs is uploaded to
# OpenRouter and its upstream provider. Unset = backends not registered.
# OPENROUTER_KEY=
# OPENROUTER_MODELS=
# OPENROUTER_DEFAULT_MODEL=openai/whisper-large-v3

# ---- Forced alignment ----
# The aligner service re-times words from the local whisper models with a
# wav2vec2 model (Norwegian: NbAiLab/nb-wav2vec2-1b-bokmaal-v2; also nn, en,
# de, nl). Cloud backends are not aligned. Empty ALIGNER_URL turns it off.
# ALIGNER_URL=http://aligner:8000
# ALIGN_PRELOAD=no
# ALIGN_MODELS=no=NbAiLab/nb-wav2vec2-300m-bokmaal

# ---- Nordlyd Qwen3-ASR (local) ----
# The qwen-asr service runs NbAiLab/nordlyd-asr-qwen06B-nov26preview on the
# GPU; clients pick it with "model": "nordlyd-asr-qwen-0.6b" (or the HF repo
# name). The model is gated: HF_TOKEN must be from an account granted access.
# Without HF_TOKEN the service runs disabled and the model is not registered.
# Its words are re-timed by the aligner. Empty QWEN_ASR_URL unregisters it.
# QWEN_ASR_URL=http://qwen-asr:8000
# HF_TOKEN=
